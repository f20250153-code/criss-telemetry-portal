# Server runtime
NODE_ENV=development
PORT=4000

# Must match the deployed/local frontend origin exactly (used for CORS
# and Socket.IO's allowed origin).
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telemetry_portal

# Secret used to sign JWTs. Generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit a real value.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h
