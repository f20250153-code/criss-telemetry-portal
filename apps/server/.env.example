# Server runtime
NODE_ENV=development
PORT=4000

# Must match the deployed/local frontend origin exactly (used for CORS
# and, from Phase 4 onward, Socket.IO's allowed origin).
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telemetry_portal

# --- Added in later phases (documented here so the full contract is
#     visible from Phase 1 onward; not read by any code yet) ---
# JWT_SECRET=replace-with-a-long-random-string
# JWT_EXPIRES_IN=1h
